# Supabase connection — copy this file to .env and fill in real values. For local development, run `supabase start` and use the Project URL and publishable key it prints (this project's local stack runs on the 5434x port range to avoid colliding with other local Supabase projects — see supabase/config.toml). For a hosted project, use the values from the Supabase dashboard's API settings.
# Note for physical devices: 127.0.0.1 only works in a simulator/emulator on the same machine; a phone on the same network needs your machine's LAN IP instead.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
